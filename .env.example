# PostgreSQL (контейнер db)
POSTGRES_USER=alauto_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alauto

# Backend API
DATABASE_URL=postgresql+psycopg://alauto_app:change-me@db:5432/alauto
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8080

# Первый администратор (создаётся сидом при первом запуске)
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=change-me
